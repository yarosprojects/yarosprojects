---
import Layout from "@layouts/Layout.astro";
import fotoGraduacion from "../../../public/img/about-image.png";
import type { Language } from "@src/types/language.type";
import { i18n } from "@src/consts/i18n.files";

export function getStaticPaths() {
    return [
        { params: { locale: "es-ES" } },
        { params: { locale: "ca-ES" } },
        { params: { locale: "en-EN" } },
        { params: { locale: "en-US" } },
        { params: { locale: "uk-UA" } },
        { params: { locale: "fr-FR" } },
        { params: { locale: "pt-PT" } },
        { params: { locale: "pl-PL" } },
        { params: { locale: "de-DE" } },
        { params: { locale: "it-IT" } },
        { params: { locale: "ka-GE" } },
        { params: { locale: "et-EE" } },
        { params: { locale: "lt-LT" } },
        { params: { locale: "lv-LV" } },
        { params: { locale: "ro-RO" } },
        { params: { locale: "ro-MD" } },
        { params: { locale: "bg-BG" } },
        { params: { locale: "pt-BR" } },
        { params: { locale: "de-AT" } },
    ];
}

const locale = Astro.params.locale as Language;
const translate = i18n[locale];

const mainDegreeData = {
    studentName: "Yaroslav Klymko",
    degreeTitle: translate.academic_formation_web.degrees.gs_daw.title,
    institution: translate.academic_formation_web.degrees.gs_daw.institution,
    graduationYear: "2024",
    userPhoto: fotoGraduacion.src,
    idNumber: "01234567-X",
    expeditionDate: "05-2024",
    registryNumber: "REG-2024-88912",
    mecesLevel: "Nivel 5 (MECES / EQF)",
    ectsCredits: "120 ECTS",
};

const degreesList = [
    {
        code: translate.academic_formation_web.degrees.gs_daw.code,
        level: translate.academic_formation_web.degrees.gs_daw.level,
        title: translate.academic_formation_web.degrees.gs_daw.title,
        institution: translate.academic_formation_web.degrees.gs_daw.institution,
        period: translate.academic_formation_web.degrees.gs_daw.period,
        description: translate.academic_formation_web.degrees.gs_daw.description,
        icon: "icon-[mdi--code-json]",
        verified: true,
        homologated: false,
        status: translate.academic_formation_web.degrees.gs_daw.status,
    },
    {
        code: translate.academic_formation_web.degrees.gm_smx.code,
        level: translate.academic_formation_web.degrees.gm_smx.level,
        title: translate.academic_formation_web.degrees.gm_smx.title,
        institution: translate.academic_formation_web.degrees.gm_smx.institution,
        period: translate.academic_formation_web.degrees.gm_smx.period,
        description: translate.academic_formation_web.degrees.gm_smx.description,
        icon: "icon-[mdi--server-network]",
        verified: true,
        homologated: false,
        status: translate.academic_formation_web.degrees.gm_smx.status,
    },
    {
        code: translate.academic_formation_web.degrees.bach.code,
        level: translate.academic_formation_web.degrees.bach.level,
        title: translate.academic_formation_web.degrees.bach.title,
        institution: translate.academic_formation_web.degrees.bach.institution,
        period: translate.academic_formation_web.degrees.bach.period,
        description: translate.academic_formation_web.degrees.bach.description,
        icon: "icon-[mdi--certificate]",
        verified: true,
        homologated: true,
        countryFlag: "🇺🇦 ➔ 🇪🇸",
        status: translate.academic_formation_web.degrees.bach.status,
    },
    {
        code: translate.academic_formation_web.degrees.eso.code,
        level: translate.academic_formation_web.degrees.eso.level,
        title: translate.academic_formation_web.degrees.eso.title,
        institution: translate.academic_formation_web.degrees.eso.institution,
        period: translate.academic_formation_web.degrees.eso.period,
        description: translate.academic_formation_web.degrees.eso.description,
        icon: "icon-[mdi--school-outline]",
        verified: true,
        homologated: false,
        status: translate.academic_formation_web.degrees.eso.status,
    },
];
---

<Layout title={translate.academic_formation_web.page_title}>
    <div class="relative w-full min-h-screen overflow-hidden">
        <div class="absolute inset-0 bg-[linear-gradient(to_right,#80808012_1px,transparent_1px),linear-gradient(to_bottom,#80808012_1px,transparent_1px)] bg-size-[24px_24px] pointer-events-none"></div>
        <div class="absolute top-0 left-1/2 -translate-x-1/2 w-[1000px] h-[350px] bg-linear-to-b from-amber-500/10 via-amber-500/5 to-transparent blur-3xl pointer-events-none"></div>

        <div class="relative pt-(--header-h) max-w-5xl mx-auto px-4 sm:px-6 my-12">
            
            <div class="flex flex-col items-start gap-4 mb-12">
                <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full border border-amber-500/30 bg-amber-500/10 text-amber-400 text-xs font-mono tracking-wide">
                    <span class="w-2 h-2 rounded-full bg-amber-400 animate-pulse"></span>
                    {translate.academic_formation_web.hero_tag}
                </div>
                
                <h1 class="text-3xl sm:text-5xl font-extrabold tracking-tight dark:text-white text-black leading-tight">
                    {translate.academic_formation_web.hero_title_part1}<span class="bg-linear-to-r from-amber-400 via-amber-300 to-yellow-500 bg-clip-text text-transparent">{translate.academic_formation_web.hero_title_part2}</span>
                </h1>
                
                <p class="text-base sm:text-lg dark:text-gray-400 text-gray-600 max-w-2xl font-normal leading-relaxed">
                    {translate.academic_formation_web.hero_description}
                </p>
            </div>

            <div class="relative w-full rounded-3xl border border-amber-500/30 bg-linear-to-br from-black/90 via-slate-950 to-amber-950/30 p-6 sm:p-8 backdrop-blur-xl mb-16 shadow-2xl overflow-hidden group">
                <div class="absolute -right-20 -bottom-20 w-80 h-80 bg-amber-500/10 rounded-full blur-3xl group-hover:bg-amber-500/20 transition-all duration-700 pointer-events-none"></div>

                <div class="flex flex-col md:flex-row items-start md:items-center justify-between gap-6 border-b border-amber-500/20 pb-6 mb-6">
                    <div class="flex items-center gap-4">
                        <div class="relative w-14 h-14 rounded-2xl bg-amber-500/10 border border-amber-500/30 flex items-center justify-center shrink-0 overflow-hidden">
                            <img src={mainDegreeData.userPhoto} alt={mainDegreeData.studentName} class="w-full h-full object-cover" />
                        </div>
                        <div>
                            <div class="flex items-center gap-2">
                                <h2 class="text-lg font-bold text-white">{mainDegreeData.studentName}</h2>
                                <span class="text-[10px] font-mono px-2 py-0.5 rounded bg-amber-500/20 text-amber-300 border border-amber-500/30">{translate.academic_formation_web.verified_student}</span>
                            </div>
                            <p class="text-xs font-mono text-amber-400/90">{mainDegreeData.degreeTitle}</p>
                        </div>
                    </div>

                    <div class="flex items-center gap-4 text-xs font-mono text-gray-400">
                        <div class="flex flex-col text-right">
                            <span class="text-gray-500">{translate.academic_formation_web.national_registry}</span>
                            <span class="text-white font-bold">{mainDegreeData.registryNumber}</span>
                        </div>
                        <i class="icon-[mdi--shield-check] text-2xl text-amber-400" />
                    </div>
                </div>

                <div class="grid grid-cols-2 sm:grid-cols-4 gap-4 text-xs font-mono">
                    <div class="p-3 rounded-xl bg-white/5 border border-white/5">
                        <span class="text-gray-400 block mb-1">{translate.academic_formation_web.institution}</span>
                        <span class="text-white font-semibold truncate block">{mainDegreeData.institution}</span>
                    </div>
                    <div class="p-3 rounded-xl bg-white/5 border border-white/5">
                        <span class="text-gray-400 block mb-1">{translate.academic_formation_web.expedition}</span>
                        <span class="text-amber-300 font-bold">{mainDegreeData.expeditionDate}</span>
                    </div>
                    <div class="p-3 rounded-xl bg-white/5 border border-white/5">
                        <span class="text-gray-400 block mb-1">{translate.academic_formation_web.european_level}</span>
                        <span class="text-white font-semibold">{mainDegreeData.mecesLevel}</span>
                    </div>
                    <div class="p-3 rounded-xl bg-white/5 border border-white/5">
                        <span class="text-gray-400 block mb-1">{translate.academic_formation_web.accumulated_credits}</span>
                        <span class="text-amber-300 font-bold">{mainDegreeData.ectsCredits}</span>
                    </div>
                </div>
            </div>

            <div class="relative pl-4 sm:pl-8 border-l border-black/10 dark:border-white/10 space-y-10 my-8">
                {degreesList.map((degree) => (
                    <div class="relative group">
                        <div class="absolute -left-[25px] sm:-left-[41px] top-1.5 w-4 h-4 rounded-full border-2 border-amber-500 bg-slate-950 group-hover:scale-125 group-hover:bg-amber-400 transition-all duration-300 shadow-[0_0_10px_rgba(245,158,11,0.5)]"></div>

                        <div class="rounded-2xl border border-black/10 dark:border-white/10 bg-black/5 dark:bg-white/5 p-6 backdrop-blur-md transition-all duration-300 hover:border-amber-500/40 hover:bg-amber-500/2 flex flex-col justify-between">
                            
                            <div>
                                <div class="flex items-center justify-between gap-2 flex-wrap mb-3">
                                    <div class="flex items-center gap-2">
                                        <span class="font-mono text-xs font-bold px-2.5 py-1 rounded-md bg-amber-500/10 text-amber-400 border border-amber-500/20">
                                            {degree.code}
                                        </span>
                                        <span class="text-xs font-mono text-gray-500 dark:text-gray-400">
                                            {degree.level}
                                        </span>
                                    </div>

                                    <span class="text-xs font-mono text-gray-400 flex items-center gap-1">
                                        <i class="icon-[mdi--clock-outline]" />
                                        {degree.period}
                                    </span>
                                </div>

                                <h3 class="text-xl font-bold dark:text-white text-black mb-2 group-hover:text-amber-400 transition-colors">
                                    {degree.title}
                                </h3>

                                <p class="text-xs font-medium text-amber-500/90 mb-4 flex items-center gap-1.5">
                                    <i class="icon-[mdi--bank-outline]" />
                                    {degree.institution}
                                </p>

                                <p class="text-xs sm:text-sm dark:text-gray-300 text-gray-600 leading-relaxed mb-6">
                                    {degree.description}
                                </p>
                            </div>

                            <div class="pt-4 border-t border-black/5 dark:border-white/10 flex flex-wrap items-center justify-between gap-3">
                                <div class="flex items-center gap-2">
                                    {degree.homologated && (
                                        <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-sky-500/10 text-sky-400 border border-sky-500/20 text-xs font-mono">
                                            <i class="icon-[mdi--earth] text-sm" />
                                            {translate.academic_formation_web.homologated} {degree.countryFlag}
                                        </span>
                                    )}

                                    {degree.verified && !degree.homologated && (
                                        <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-emerald-500/10 text-emerald-400 border border-emerald-500/20 text-xs font-mono">
                                            <i class="icon-[mdi--check-decagram] text-sm" />
                                            {translate.academic_formation_web.official_degree}
                                        </span>
                                    )}
                                </div>

                                <div class="flex items-center gap-2 text-xs font-mono text-gray-400">
                                    <i class={`${degree.icon} text-lg text-amber-400`} />
                                    <span>{degree.status}</span>
                                </div>
                            </div>

                        </div>
                    </div>
                ))}
            </div>

        </div>
    </div>
</Layout>