---
import Layout from "@layouts/Layout.astro";
import { i18n } from "@consts/i18n.files";
import type { Language } from "@src/types/language.type";
import escudoEspanya from "../../../public/img/escudo-espanya.svg";
import fotoCarnet from "../../../public/img/about-image.png";

export function getStaticPaths() {
    return [
        { params: { locale: "es-ES" } },
        { params: { locale: "ca-ES" } },
        { params: { locale: "en-EN" } },
        { params: { locale: "en-US" } },
        { params: { locale: "uk-UA" } },
        { params: { locale: "fr-FR" } },
        { params: { locale: "pt-PT" } },
        { params: { locale: "pl-PL" } },
        { params: { locale: "de-DE" } },
        { params: { locale: "it-IT" } },
        { params: { locale: "ka-GE" } },
        { params: { locale: "et-EE" } },
        { params: { locale: "lt-LT" } },
        { params: { locale: "lv-LV" } },
        { params: { locale: "ro-RO" } },
        { params: { locale: "ro-MD" } },
        { params: { locale: "bg-BG" } },
        { params: { locale: "pt-BR" } },
        { params: { locale: "de-AT" } },
    ];
}

export type PluralCategory = {
    one: string;
    other: string;
    few?: string;
    many?: string;
    zero?: string;
    [key: string]: string | undefined;
};
const locale = Astro.params.locale as Language;
const translate = i18n[locale];
const creador = translate.creator_name;

const cardData = {
    surname1: translate.creator_name_variants.first_name,
    surname2: translate.creator_name_variants.last_name,
    name: translate.creator_name_variants.full_name,
    birthDate: "17-02-2005",
    birthPlace: translate.countries.ukraine,
    issueDate: "01-03-2024",
    expiryDate: "01-03-2034",
    authority: "99-00",
    idNumber: "01234567-X",
    userPhoto: fotoCarnet.src,
    licenses: [
        { code: "B", issue: "01-03-2024", expiry: "01-03-2034", obs: "" },
        // { code: "BE", issue: "10-10-2026", expiry: "10-10-2036", obs: "" },
        { code: "C1", issue: "10-10-2026", expiry: "10-10-2031", obs: "95" },
        { code: "C", issue: "10-10-2026", expiry: "10-10-2031", obs: "95" },
        // { code: "C1E", issue: "05-05-2027", expiry: "05-05-2032", obs: "95" },
        // { code: "CE", issue: "05-05-2027", expiry: "05-05-2032", obs: "95" },
    ],
};

const allCategories = [
    { code: "AM", icon: "icon-[mdi--motorbike]" },
    { code: "A1", icon: "icon-[mdi--motorbike]" },
    { code: "A2", icon: "icon-[mdi--motorbike]" },
    { code: "A", icon: "icon-[mdi--motorbike]" },
    { code: "B1", icon: "icon-[mdi--car-side]" },
    { code: "B", icon: "icon-[mdi--car-side]" },
    { code: "BE", icon: "icon-[mdi--car-estate]" },
    { code: "C1", icon: "icon-[mdi--truck-delivery-outline]" },
    { code: "C", icon: "icon-[mdi--truck-outline]" },
    { code: "C1E", icon: "icon-[mdi--truck-trailer]" },
    { code: "CE", icon: "icon-[mdi--truck-trailer]" },
    { code: "D1", icon: "icon-[mdi--bus-side]" },
    { code: "D", icon: "icon-[mdi--bus]" },
    { code: "D1E", icon: "icon-[mdi--bus]" },
    { code: "DE", icon: "icon-[mdi--bus]" },
];

const licenses = [
    {
        code: translate.driving_licenses.driving_license_categories.b.category,
        title: translate.driving_licenses.driving_license_categories.b.title,
        description:
            translate.driving_licenses.driving_license_categories.b.description,
        img: "/img/driving-licenses/B.png",
        cap: false,
    },
    {
        code: translate.driving_licenses.driving_license_categories.c1.category,
        title: translate.driving_licenses.driving_license_categories.c1.title,
        description:
            translate.driving_licenses.driving_license_categories.c1
                .description,
        img: "/img/driving-licenses/C1.png",
        cap: true,
    },
    {
        code: translate.driving_licenses.driving_license_categories.c.category,
        title: translate.driving_licenses.driving_license_categories.c.title,
        description:
            translate.driving_licenses.driving_license_categories.c.description,
        img: "/img/driving-licenses/C.png",
        cap: true,
    },
];

function getPluralLabel(
    count: number,
    lang: string,
    category: PluralCategory,
): string {
    const pr = new Intl.PluralRules(lang);
    const rule = pr.select(count); // Devuelve: 'zero', 'one', 'two', 'few', 'many', u 'other'

    // Busca la regla exacta; si no existe en ese idioma, usa 'other' o 'one'
    return (
        category[rule as keyof PluralCategory] || category.other || category.one
    );
}
---

<Layout title="Licencias de conducción">
    <!-- Fondo decorativo OpenAI Style Grid -->
    <div class="fixed inset-0 pointer-events-none -z-10 overflow-hidden">
        <div
            class="absolute inset-0 bg-[radial-gradient(circle_at_50%_0%,rgba(14,165,233,0.08),transparent_50%)]"
        >
        </div>
        <div
            class="absolute inset-0 bg-[linear-gradient(to_right,rgba(255,255,255,0.03)_1px,transparent_1px),linear-gradient(to_bottom,rgba(255,255,255,0.03)_1px,transparent_1px)] bg-size-[4rem_4rem] mask-[radial-gradient(ellipse_60%_50%_at_50%_0%,#000_70%,transparent_100%)]"
        >
        </div>
    </div>

    <!-- Header Principal -->
    <div
        class="pt-(--header-h) w-full flex justify-center items-center px-4 md:px-0 mt-6"
    >
        <div
            class="w-full md:max-w-3xl mx-auto flex flex-col items-center text-center gap-3"
        >
            <div
                class="inline-flex items-center gap-2 px-3 py-1 rounded-full border border-cyan-500/30 bg-cyan-500/10 backdrop-blur-md text-cyan-400 text-xs font-mono tracking-wider uppercase mb-2"
            >
                <span class="w-2 h-2 rounded-full bg-cyan-400 animate-pulse"
                ></span>
                {translate.driving_licenses.label}
            </div>
            <h1
                class="text-3xl md:text-5xl font-extrabold tracking-tight text-transparent bg-clip-text bg-linear-to-r from-white via-slate-200 to-slate-400"
            >
                {translate.driving_licenses.title}
            </h1>
            <p class="text-sm md:text-base text-slate-400 max-w-xl">
                {translate.driving_licenses.subtitle}
            </p>
        </div>
    </div>

    <!-- Tarjeta Interactiva 3D -->
    <section
        id="driving-license-card"
        class="w-full flex flex-col justify-center items-center my-10 px-4 select-none"
    >
        <div
            class="inline-flex items-center gap-2 text-xs font-mono text-slate-400 mb-6 px-4 py-1.5 rounded-full bg-white/5 border border-white/10 backdrop-blur-md animate-pulse"
        >
            <i class="icon-[mdi--gesture-tap] text-base text-cyan-400"></i>
            {translate.driving_licenses.tocuh_or_click}
        </div>

        <div
            id="card-trigger"
            class="card-container group perspective-distant w-full max-w-[480px] aspect-[1.586/1] cursor-pointer"
        >
            <div
                id="card-inner"
                class="card-inner relative w-full h-full duration-700 transform-3d group-hover:transform-[rotateY(180deg)] in-[.flipped]:transform-[rotateY(180deg)] rounded-[18px] shadow-[0_20px_50px_rgba(0,0,0,0.5)] transition-all"
            >
                <div
                    class="animate-fade-in-up card-front absolute inset-0 w-full h-full rounded-[18px] p-4 bg-[#f6cfd9]/95 bg-[radial-gradient(#e8a2b5_1.2px,transparent_1.2px)] background-size-[10px_10px] text-slate-900 font-sans backface-hidden flex flex-col justify-between overflow-hidden border border-pink-300/60 shadow-inner"
                >
                    <div
                        class="absolute -right-6 -bottom-20 pointer-events-none z-0"
                    >
                        <img
                            src={escudoEspanya.src}
                            alt="Escudo de España"
                            class="w-56 h-auto object-contain opacity-40 drop-shadow-md"
                        />
                    </div>

                    <div
                        class="flex items-center justify-between z-10 gap-2 border-b border-pink-400/40 pb-1"
                    >
                        <div
                            class="w-14 h-9 bg-[#003399] rounded-[3px] p-0.5 flex flex-col items-center justify-center text-white border border-yellow-400 shrink-0 shadow-sm"
                        >
                            <div
                                class="flex gap-0.5 text-[7px] text-yellow-300 leading-none"
                            >
                                ★ ★ ★
                            </div>
                            <span
                                class="text-sm font-bold tracking-tighter leading-none mt-0.5"
                                >E</span
                            >
                            <div
                                class="flex gap-0.5 text-[7px] text-yellow-300 leading-none"
                            >
                                ★ ★ ★
                            </div>
                        </div>
                        <div
                            class="flex-1 text-center font-bold tracking-tight text-slate-800 text-[11px] sm:text-[13px] uppercase"
                        >
                            {translate.driving_licenses.driving_license}
                            <span
                                class="text-slate-900 block sm:inline font-extrabold"
                                >{
                                    translate.driving_licenses.spanish_kingdom
                                }</span
                            >
                        </div>
                    </div>

                    <div
                        class="grid grid-cols-12 gap-2 my-auto z-10 items-center"
                    >
                        <div class="col-span-4 flex flex-col items-start pl-1">
                            <div
                                class="w-20 sm:w-24 h-24 sm:h-28 bg-slate-200 border border-slate-400/60 rounded-sm shadow-md overflow-hidden relative flex items-center justify-center shrink-0"
                            >
                                <img
                                    src={cardData.userPhoto}
                                    alt="Foto carnet"
                                    class="w-full h-full object-cover object-center"
                                />
                            </div>
                        </div>

                        <div
                            class="col-span-8 space-y-0.5 text-[10px] sm:text-[11px] font-mono leading-snug pl-1"
                        >
                            <div>
                                <span class="font-bold font-sans text-rose-900"
                                    >1.</span
                                >
                                <span class="font-extrabold uppercase"
                                    >{cardData.surname1}</span
                                >
                            </div>
                            <div class="pl-3.5 font-extrabold uppercase">
                                {cardData.surname2}
                            </div>
                            <div>
                                <span class="font-bold font-sans text-rose-900"
                                    >2.</span
                                >
                                <span class="font-extrabold uppercase"
                                    >{cardData.name}</span
                                >
                            </div>
                            <div>
                                <span class="font-bold font-sans text-rose-900"
                                    >3.</span
                                >
                                {cardData.birthDate}
                                <span class="font-extrabold uppercase ml-2"
                                    >{cardData.birthPlace}</span
                                >
                            </div>
                            <div>
                                <span class="font-bold font-sans text-rose-900"
                                    >4a.</span
                                >
                                {cardData.issueDate}
                                <span
                                    class="font-bold font-sans text-rose-900 ml-2"
                                    >4b.</span
                                >
                                {cardData.expiryDate}
                            </div>
                            <div>
                                <span class="font-bold font-sans text-rose-900"
                                    >4c.</span
                                >
                                {cardData.authority}
                            </div>
                            <div class="pt-2">
                                <span class="font-bold font-sans text-rose-900"
                                    >5.</span
                                >
                            </div>
                            <div
                                class="text-xs sm:text-sm font-extrabold tracking-wider"
                            >
                                {cardData.idNumber}
                            </div>
                            <div class="pt-1 flex items-center gap-2">
                                <span class="font-bold font-sans text-rose-900"
                                    >9.</span
                                >
                                <span class="font-extrabold text-sm">
                                    {
                                        cardData.licenses
                                            .map((l) => l.code)
                                            .join(", ")
                                    }
                                </span>
                            </div>
                        </div>
                    </div>

                    <div
                        class="flex justify-between items-end text-[8px] text-slate-600 z-10 font-sans border-t border-pink-400/30 pt-1"
                    >
                        <span class="uppercase"
                            >{
                                translate.driving_licenses
                                    .european_community_model
                            }</span
                        >
                    </div>
                </div>

                <div
                    class="card-back absolute inset-0 w-full h-full rounded-[18px] p-3 bg-[#f6cfd9] bg-[radial-gradient(#e8a2b5_1.2px,transparent_1.2px)] bg-size-[10px_10px] text-slate-900 font-sans backface-hidden transform-[rotateY(180deg)] flex flex-col justify-between overflow-hidden border border-pink-300 shadow-inner"
                >
                    <div class="z-10 w-full h-full flex gap-2">
                        <div
                            class="w-auto text-[7.5px] sm:text-[11px] leading-tight space-y-1 text-slate-800 font-sans flex flex-col justify-between py-1"
                        >
                            <div class="space-y-1.5">
                                <p>
                                    <span class="font-bold text-rose-900"
                                        >1.</span
                                    >
                                    {translate.driving_licenses.last_names}
                                </p>
                                <p>
                                    <span class="font-bold text-rose-900"
                                        >2.</span
                                    >
                                    {translate.driving_licenses.name}
                                </p>
                                <p>
                                    <span class="font-bold text-rose-900"
                                        >3.</span
                                    >
                                    {
                                        translate.driving_licenses
                                            .date_and_place_of_birth
                                    }
                                </p>
                                <p>
                                    <span class="font-bold text-rose-900"
                                        >4a.</span
                                    >
                                    {translate.driving_licenses.valid_from}
                                </p>
                                <p>
                                    <span class="font-bold text-rose-900"
                                        >4b.</span
                                    >
                                    {translate.driving_licenses.valid_until}
                                </p>
                                <p>
                                    <span class="font-bold text-rose-900"
                                        >4c.</span
                                    >
                                    {
                                        translate.driving_licenses
                                            .issuing_authority
                                    }
                                </p>
                                <p>
                                    <span class="font-bold text-rose-900"
                                        >5.</span
                                    >
                                    {translate.driving_licenses.number}
                                </p>
                                <p>
                                    <span class="font-bold text-rose-900"
                                        >10.</span
                                    >
                                    {translate.driving_licenses.valid_from}
                                </p>
                                <p>
                                    <span class="font-bold text-rose-900"
                                        >11.</span
                                    >
                                    {translate.driving_licenses.valid_until}
                                </p>
                                <p>
                                    <span class="font-bold text-rose-900"
                                        >12.</span
                                    >
                                    {translate.driving_licenses.observations}
                                </p>
                            </div>
                            <div
                                class="text-[9px] font-bold text-rose-900/60 tracking-widest rotate-90 origin-left translate-y-4"
                            >
                                ESPECIMEN
                            </div>
                        </div>

                        <div class="w-full h-full">
                            <table
                                class="w-full text-left border-collapse border border-pink-400/50 bg-white/40 text-[10px] sm:text-[8px] font-mono"
                            >
                                <thead>
                                    <tr
                                        class="bg-pink-300/40 text-slate-900 font-bold border-b border-pink-400/50"
                                    >
                                        <th
                                            class="p-0.5 text-center border-r border-pink-400/50"
                                            >9.</th
                                        >
                                        <th
                                            class="p-0.5 text-center border-r border-pink-400/50"
                                            >10.</th
                                        >
                                        <th
                                            class="p-0.5 text-center border-r border-pink-400/50"
                                            >11.</th
                                        >
                                        <th class="p-0.5 text-center">12.</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    {
                                        allCategories.map((cat) => {
                                            const userLic =
                                                cardData.licenses.find(
                                                    (l) => l.code === cat.code,
                                                );
                                            return (
                                                <tr class="border-b border-pink-300/30">
                                                    <td class="p-0.5 font-bold border-r border-pink-400/50 flex items-center justify-between gap-1 px-1">
                                                        <span>{cat.code}</span>
                                                        <i
                                                            class={`${cat.icon} text-[10px] opacity-70`}
                                                        />
                                                    </td>
                                                    <td class="p-0.5 text-center border-r border-pink-400/50">
                                                        {userLic
                                                            ? userLic.issue
                                                            : "-------"}
                                                    </td>
                                                    <td class="p-0.5 text-center border-r border-pink-400/50">
                                                        {userLic
                                                            ? userLic.expiry
                                                            : "-------"}
                                                    </td>
                                                    <td class="p-0.5 text-center font-bold text-rose-900">
                                                        {userLic
                                                            ? userLic.obs
                                                            : "-------"}
                                                    </td>
                                                </tr>
                                            );
                                        })
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>
    <div class="flex w-full flex-col px-4 md:px-0 my-12">
        <div class="w-full md:max-w-3xl mx-auto flex flex-col gap-6">
            <div
                class="flex items-center justify-between border-b border-white/10 pb-4 mb-2"
            >
                <h2
                    class="text-xl font-semibold text-white tracking-tight flex items-center gap-2"
                >
                    <i class="icon-[mdi--shield-check] text-cyan-400 text-2xl"
                    ></i>
                    {translate.driving_licenses.enabled_categories}
                </h2>
                <span class="text-xs font-mono text-slate-400">
                    {translate.driving_licenses.total_label}: {licenses.length}
                    {
                        getPluralLabel(
                            licenses.length,
                            locale,
                            translate.driving_licenses.categories_enum as PluralCategory,
                        )
                    }
                </span>
            </div>

            {
                licenses.map((license) => (
                    <div class="group relative rounded-2xl border border-white/10 bg-slate-900/40 backdrop-blur-md p-6 flex flex-col md:flex-row justify-between items-center gap-6 overflow-hidden transition-all duration-300 hover:border-cyan-500/40 hover:bg-slate-900/60 hover:shadow-[0_0_30px_rgba(6,182,212,0.1)]">
                        <div class="absolute -right-16 -top-16 w-32 h-32 bg-cyan-500/10 rounded-full blur-2xl group-hover:bg-cyan-500/20 transition-all pointer-events-none" />

                        <div class="flex-1 flex flex-col items-start text-left z-10 space-y-3">
                            <div class="flex items-center gap-3 flex-wrap">
                                <span class="bg-cyan-500/10 text-cyan-400 border border-cyan-500/30 font-mono font-bold px-3.5 py-1 rounded-lg text-sm tracking-wide shadow-sm">
                                    {license.code}
                                </span>

                                {license.cap && (
                                    <span class="inline-flex items-center gap-1.5 bg-emerald-500/10 text-emerald-400 border border-emerald-500/30 text-xs font-semibold px-3 py-1 rounded-full shadow-[0_0_15px_rgba(16,185,129,0.15)]">
                                        <i class="icon-[mdi--certificate-check] text-sm" />
                                        {translate.cap_mercancias.title}
                                    </span>
                                )}
                            </div>

                            <h3 class="text-xl font-bold text-white group-hover:text-cyan-300 transition-colors">
                                {license.title}
                            </h3>

                            <p class="text-sm text-slate-300 leading-relaxed font-light">
                                {license.description}
                            </p>

                            {license.cap && (
                                <div class="inline-flex items-center gap-2 text-xs text-emerald-400/90 font-mono pt-1 bg-emerald-950/30 px-3 py-1 rounded-md border border-emerald-500/20">
                                    <i class="icon-[mdi--shield-check-outline]" />
                                    {
                                        translate.driving_licenses
                                            .driving_license_categories
                                            .common_notes.c_95_initial
                                    }
                                </div>
                            )}
                        </div>

                        <div class="relative w-full md:w-56 h-36 flex justify-center items-center shrink-0 rounded-xl bg-slate-950/40 border border-white/5 p-2">
                            <img
                                src={license.img}
                                alt={license.title}
                                class="max-h-28 max-w-full object-contain filter drop-shadow-[0_10px_15px_rgba(0,0,0,0.5)] relative z-10 transition-all duration-300 group-hover:scale-105"
                            />
                            <img
                                src={license.img}
                                alt={`${license.title} reflejo`}
                                aria-hidden="true"
                                class="absolute top-[75%] max-h-24 max-w-full object-contain scale-y-[-1] opacity-15 blur-[2px] pointer-events-none translate-x-1 mask-[linear-gradient(to_bottom,black,transparent)] [-webkit-mask-image:linear-gradient(to_bottom,black,transparent)]"
                            />
                        </div>
                    </div>
                ))
            }
        </div>
    </div>
</Layout>

<script is:inline>
    document.addEventListener("astro:page-load", () => {
        const cardTrigger = document.getElementById("card-trigger");

        cardTrigger?.addEventListener("click", () => {
            cardTrigger?.classList.toggle("flipped");
        });
    });
</script>
